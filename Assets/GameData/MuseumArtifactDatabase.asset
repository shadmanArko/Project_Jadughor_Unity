  artifacts:
  - Descriptive:
      Id: AncientNativeAmericanClub
      ArtifactName: Ancient Native American Club
      Description: Few things are as reliable as fitting a sizeable rock on a stick.
    Functional:
      Id: AncientNativeAmericanClub
      Era: Ancient
      Region: American
      Object: Club
      Materials:
      - Wood
      - Stone
      ObjectClass: Weapon
      ObjectSize: Medium
