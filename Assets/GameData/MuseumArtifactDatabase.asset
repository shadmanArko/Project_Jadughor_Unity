    IsometricSprite: {fileID: 21300000, guid: 16cb0c10549034b4ca37cd3aa2943417, type: 3}
  - Descriptive:
      Id: MedievalNativeAmericanTomahawk
      ArtifactName: Medieval Native American Tomahawk
      Description: Prior to Colombian Exchange, tomahawks used by the natives were
        made from both stone and bone.
    Functional:
      Id: MedievalNativeAmericanTomahawk
      Era: Medieval
      Region: American
      Object: Axe
      Materials:
      - Wood
      - Stone
      ObjectClass: Weapon
      ObjectSize: Medium
