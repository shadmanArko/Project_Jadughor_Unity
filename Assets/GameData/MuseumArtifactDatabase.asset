  - Descriptive:
      Id: ClassicalNativeAmericanTomahawk
      ArtifactName: Classical Native American Tomahawk
      Description: Evidence suggests that the earliest tomahawks were tied together
        with animal sinew.
    Functional:
      Id: ClassicalNativeAmericanTomahawk
      Era: Classical
      Region: American
      Object: Axe
      Materials:
      - Wood
      - Bone
      ObjectClass: Weapon
      ObjectSize: Medium
